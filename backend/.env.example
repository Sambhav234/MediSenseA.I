# ─────────────────────────────────────────────────────────────────────────────
# MediSense AI v3 — Environment Configuration
# Copy:  copy backend\.env.example backend\.env     (Windows)
#        cp backend/.env.example backend/.env       (Mac/Linux)
# Then fill in your values below.
# NEVER commit your real .env file to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000
SECRET_KEY=change-me-to-a-long-random-string

# ── CORS ──────────────────────────────────────────────────────────────────────
# Use * for local dev; restrict to your frontend URL in production.
CORS_ORIGINS=*

# ── Google Maps API (optional) ────────────────────────────────────────────────
# Enables real nearby-doctor search. Without this, demo data is shown.
# Get key: https://console.cloud.google.com/
# Enable: Places API, Maps JavaScript API, Directions API
GOOGLE_MAPS_API_KEY=

# ── Gemini API (optional — LLM explanation layer) ─────────────────────────────
# Used to generate human-friendly explanations of predictions.
# Get key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# ── MongoDB (optional — persistent history + user accounts) ───────────────────
MONGO_URI=mongodb://localhost:27017/medisense
